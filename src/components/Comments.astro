---
import { SITE_CONFIG } from '../lib/site';

interface Props {
  slug: string;
  title: string;
}

const { title } = Astro.props;
const cfg = SITE_CONFIG.comments;
const isGiscusConfigured = Boolean(cfg.repo && cfg.repoId && cfg.categoryId);
const isDev = import.meta.env.DEV;
const discussionSearchUrl = `${cfg.discussionsUrl}?discussions_q=${encodeURIComponent(title)}`;
---

<section
  id="comments"
  aria-labelledby="comments-heading"
  class="mt-8 rounded-xl border border-slate-200/80 dark:border-slate-800/90 bg-white dark:bg-slate-900/75 p-6 sm:p-8 shadow-[0_1px_3px_rgba(15,23,42,0.03)] dark:shadow-[0_12px_32px_rgba(2,6,23,0.4)] scroll-mt-24 print:hidden"
>
  <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-5 mb-6">
    <div>
      <div class="font-mono text-[11px] font-semibold uppercase tracking-wider text-teal-700 dark:text-teal-400">
        // Discussion
      </div>
      <h2
        id="comments-heading"
        class="mt-1 font-display text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-50"
      >
        Comments
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        Questions, feedback, or edge cases? Sign in with GitHub to leave a comment — Markdown &amp; code blocks are supported.
      </p>
    </div>

    <a
      href={discussionSearchUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-700/90 bg-slate-50 dark:bg-slate-800/80 px-3 py-1.5 font-mono text-xs font-medium text-slate-600 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-white dark:hover:bg-slate-800 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
    >
      <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
      </svg>
      <span>GitHub Discussions</span>
      <span aria-hidden="true">&nearr;</span>
    </a>
  </div>

  {isGiscusConfigured ? (
    <div
      id="giscus-container"
      class="giscus min-h-[160px]"
      data-repo={cfg.repo}
      data-repo-id={cfg.repoId}
      data-category={cfg.category}
      data-category-id={cfg.categoryId}
      data-mapping={cfg.mapping}
      data-strict={cfg.strict}
      data-reactions-enabled={cfg.reactionsEnabled}
      data-emit-metadata={cfg.emitMetadata}
      data-input-position={cfg.inputPosition}
      data-lang={cfg.lang}
    ></div>
  ) : (
    <div class="rounded-xl border border-dashed border-slate-200 dark:border-slate-700/80 bg-slate-50/70 dark:bg-slate-950/50 p-6 text-center">
      <p class="text-sm text-slate-600 dark:text-slate-300">
        Join the conversation on GitHub Discussions to ask questions or share notes about this post.
      </p>
      <div class="mt-4">
        <a
          href={discussionSearchUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-slate-900 dark:bg-teal-500 px-4 py-2.5 text-xs sm:text-sm font-semibold text-white dark:text-slate-950 shadow-sm hover:bg-teal-700 dark:hover:bg-teal-400 transition-colors"
        >
          <span>Discuss on GitHub</span>
          <span aria-hidden="true">&nearr;</span>
        </a>
      </div>

      {isDev && (
        <div class="mt-6 rounded-lg border border-teal-200/80 dark:border-teal-800/70 bg-teal-50/70 dark:bg-teal-950/40 p-4 text-left text-xs text-slate-700 dark:text-slate-300">
          <div class="font-mono font-semibold text-teal-800 dark:text-teal-300 mb-1.5">
            [Local Dev Hint] Complete 1-time Giscus widget setup:
          </div>
          <ol class="list-decimal pl-4 space-y-1">
            <li>
              Enable <strong>Discussions</strong> in your GitHub repo settings (<code>{cfg.repo}</code>) and install the{' '}
              <a href="https://github.com/apps/giscus" target="_blank" rel="noopener noreferrer" class="underline font-medium text-teal-700 dark:text-teal-400">
                giscus GitHub App
              </a>.
            </li>
            <li>
              Visit <a href="https://giscus.app" target="_blank" rel="noopener noreferrer" class="underline font-medium text-teal-700 dark:text-teal-400">giscus.app</a>, enter <code>{cfg.repo}</code>, and copy your <code>data-repo-id</code> &amp; <code>data-category-id</code>.
            </li>
            <li>
              Set <code>PUBLIC_GISCUS_REPO_ID</code> and <code>PUBLIC_GISCUS_CATEGORY_ID</code> in <code>.env</code> (and Cloudflare Pages environment variables) or in <code>src/lib/site.ts</code>.
            </li>
          </ol>
        </div>
      )}
    </div>
  )}
</section>

{isGiscusConfigured && (
  <script is:inline>
    (function () {
      const container = document.getElementById('giscus-container');
      if (!container) return;

      function getGiscusTheme() {
        return document.documentElement.classList.contains('dark')
          ? 'dark_dimmed'
          : 'light';
      }

      function mountGiscus() {
        if (container.querySelector('script, iframe')) return;
        const script = document.createElement('script');
        script.src = 'https://giscus.app/client.js';
        script.async = true;
        script.crossOrigin = 'anonymous';
        script.setAttribute('data-repo', container.getAttribute('data-repo') || '');
        script.setAttribute('data-repo-id', container.getAttribute('data-repo-id') || '');
        script.setAttribute('data-category', container.getAttribute('data-category') || 'General');
        script.setAttribute('data-category-id', container.getAttribute('data-category-id') || '');
        script.setAttribute('data-mapping', container.getAttribute('data-mapping') || 'pathname');
        script.setAttribute('data-strict', container.getAttribute('data-strict') || '0');
        script.setAttribute('data-reactions-enabled', container.getAttribute('data-reactions-enabled') || '1');
        script.setAttribute('data-emit-metadata', container.getAttribute('data-emit-metadata') || '0');
        script.setAttribute('data-input-position', container.getAttribute('data-input-position') || 'top');
        script.setAttribute('data-theme', getGiscusTheme());
        script.setAttribute('data-lang', container.getAttribute('data-lang') || 'en');
        script.setAttribute('data-loading', 'lazy');
        container.appendChild(script);
      }

      function syncGiscusTheme() {
        const iframe = document.querySelector('iframe.giscus-frame');
        if (!iframe || !iframe.contentWindow) return;
        iframe.contentWindow.postMessage(
          { giscus: { setConfig: { theme: getGiscusTheme() } } },
          'https://giscus.app'
        );
      }

      mountGiscus();

      window.addEventListener('theme-change', syncGiscusTheme);
      const observer = new MutationObserver(syncGiscusTheme);
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class'],
      });
    })();
  </script>
)}
